#!/usr/bin/env sh
# Formats staged .ts/.tsx through prettier before the commit is written (#398).
#
# The shebang is load-bearing on Windows: without it git cannot exec the file
# and fails with a misleading "cannot spawn .husky/pre-commit: No such file or
# directory" even though the file is plainly there. The executable bit is
# recorded in git's index (`git update-index --chmod=+x`) so it survives for
# anyone who clones, regardless of their `core.fileMode`.
#
# Skips itself when lint-staged isn't installed locally. `core.hooksPath` is
# written to the *shared* `.git/config`, which every linked worktree reads — so
# a worktree whose `node_modules` predates this change can reach this hook
# without the dependency. A bare `npx lint-staged` would then try the registry
# mid-commit, turning a missing devDependency into a hang or a confusing
# failure. Exiting 0 degrades to "no formatting on this commit", which the CI
# gate catches anyway.
#
# This is convenience, not the guarantee — it can be skipped with
# `--no-verify`, it doesn't exist until someone runs `npm install`, and it
# never runs for a commit made through the GitHub web UI. `npm run
# format:check` in the Lint workflow is what actually enforces the rule.
if [ ! -x "node_modules/.bin/lint-staged" ]; then
  echo "pre-commit: lint-staged not installed, skipping format (CI still checks)"
  exit 0
fi

npx --no-install lint-staged
